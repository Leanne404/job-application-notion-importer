  if(icon.type==='custom_emoji' && icon.custom_emoji && icon.custom_emoji.id) return {type:'custom_emoji',custom_emoji:{id:icon.custom_emoji.id}};
  if(icon.type==='icon' && icon.icon && typeof icon.icon.name==='string' && icon.icon.name) {
