lement('option');option.value=item.id;option.textContent=item.name;$('source').append(option);}$('source').hidden=false;$('setupStatus').textContent='Select a data source, then click Connect Notion.';}\n    else {$('secret').value='';$('databaseLink').value='';$('setupStatus').textContent='Connected. Settings are saved in your private project.';$('setup').open=false;resetPreview();}\n  }catch(e){$('setupStatus').textContent=errorMessage(e);}\n  finally{busy(false);}\n};\n\n// Website controls and results are independent of the Gmail workflow above.\nfunction chooseWorkflow(website){\n  if(working)return;\n  $('gmailPanel').hidden=website;$('websitePanel').hidden=!website;\n  $('gmailMode').setAttribute('aria-pressed',String(!website));$('websiteMode').setAttribute('aria-pressed',String(website));\n  $('gmailMode').className=website?'secondary':'';$('websiteMode').className=website?'':'secondary';\n}\n$('gmailMode').onclick=()=>chooseWorkflow(false);$('websiteMode').onclick=()=>chooseWorkflow(true);\nfunction resetWebsite(){websiteTickets=[];websiteResults=[];$('websiteRows').replaceChildren();$('websiteTable').hidden=true;$('websiteEmpty').hidden=false;$('websiteMessage').textContent='Preview again before filling blank fields.';}\n$('websiteDate').onchange=()=>{\n  if(!$('websiteDate').checkValidity()){$('websiteFill').disabled=true;$('websiteMessage').textContent='Enter a valid application date.';return;}\n  const value=$('websiteDate').value||'Today when confirmed';\n  renderWebsites(websiteResults.map(row=>row.state==='ready'&&(row.fields||[]).includes('Apply Date')?{...row,'Apply Date':value}:row));\n  busy(false);if(websiteTickets.length)$('websiteMessage').textContent='Application date updated. Review the results, then fill blank fields. No new website search is needed.';\n};\nfunction websiteError(e){websiteTickets=[];busy(false);const message=errorMessage(e);$('websiteMessage').textContent=/Script function not found/i.test(message)?'The Website backend is mi