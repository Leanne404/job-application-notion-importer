# Default deny: only explicitly reviewed source files may enter this repository.
/*
!/.gitignore
!/README.md
!/SingleFile.gs
!/Code.gs
!/Website.gs
!/Index.html
!/appsscript.json
!/cli.mjs
!/lib/
/lib/*
!/lib/local.mjs
!/lib/engine.mjs
!/lib/google.mjs
!/scripts/
/scripts/*
!/scripts/build-single.py
!/scripts/check-private.py
!/scripts/pre-commit
!/scripts/pre-push
!/tests/
/tests/*
!/tests/core.test.cjs
!/tests/website.test.cjs
!/tests/cli.test.mjs

# Defense in depth for private files at any depth.
.local/
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
__MACOSX/
Thumbs.db
Desktop.ini
.env
.env.*
*.local
*.local.*
*secret*
*credential*
*token*
auth.json
config.json
.clasp.json
.clasprc.json
.npmrc
.pypirc
.netrc
.git-credentials
.codex/
.claude/
.openai/
.config/
.ssh/
.aws/
.azure/
.gcloud/
secrets/
credentials/
private/
work/
outputs/
data/
logs/
backups/
screenshots/
*.pem
*.key
*.p12
*.pfx
*.keystore
*.log
*.sqlite*
*.db
*.eml
*.mbox
*.csv
*.zip
*.tar*
*.gz
*.png
*.jpg
*.jpeg
*.pdf
__pycache__/
node_modules/

# Optional browser fallback: reviewed source only.
!/extension/
/extension/*
!/BrowserFallback.gs
!/tests/browser.test.cjs
!/tests/extension.test.mjs
!/extension/package.json
!/extension/package-lock.json
!/extension/core.mjs
!/extension/capture.mjs
!/extension/background.mjs
!/extension/manifest.json
!/extension/review.html
!/extension/review.css
!/extension/review.mjs
!/extension/build.mjs
!/extension/model-integrity.json
